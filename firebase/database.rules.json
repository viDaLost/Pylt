{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta').child('controllerUid').val() === auth.uid) || (data.exists() && data.child('meta').child('controllerUid').val() === auth.uid))",
        "meta": {
          ".validate": "newData.hasChildren(['controllerUid', 'controllerName', 'createdAt', 'version']) && newData.child('controllerUid').isString() && newData.child('controllerName').isString() && newData.child('controllerName').val().length <= 40 && newData.child('version').isNumber()"
        },
        "activeParticipantId": {
          ".validate": "!newData.exists() || (newData.isString() && root.child('rooms').child($roomId).child('participants').child(newData.val()).child('role').val() === 'receiver')"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'role', 'online']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40 && (newData.child('role').val() === 'receiver' || newData.child('role').val() === 'controller') && newData.child('online').isBoolean())"
          }
        },
        "messages": {
          ".indexOn": ["createdAt"],
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($roomId).child('participants').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'createdAt'])",
            "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val() === root.child('rooms').child($roomId).child('participants').child(auth.uid).child('name').val() && newData.val().length > 0 && newData.val().length <= 40" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "voice": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('participants').child(auth.uid).exists()",
          "members": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('participants').child(auth.uid).exists()"
            }
          },
          "speaker": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('participants').child(auth.uid).exists() && (!newData.exists() || newData.child('uid').val() === auth.uid)"
          },
          "connections": {
            "$pairId": {
              ".write": "auth != null && root.child('rooms').child($roomId).child('participants').child(auth.uid).exists()"
            }
          }
        }
      }
    }
  }
}